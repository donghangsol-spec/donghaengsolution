{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/app",
      "destination": "/next"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/index",
      "destination": "/accounting",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/accounting",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/email-intake-cron",
      "schedule": "0 0 * * *"
    }
  ],
  "functions": {
    "api/email-intake-collect.js": {
      "maxDuration": 60
    },
    "api/email-intake-cron.js": {
      "maxDuration": 60
    }
  }
}
