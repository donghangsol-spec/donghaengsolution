# Vercel Project Environment Variables (Preview and Production)
# Only SUPABASE_URL and SUPABASE_ANON_KEY are exposed through /api/config.js.
# Never use a service-role key as SUPABASE_ANON_KEY. RESEND_API_KEY is server-only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
RESEND_API_KEY=
CONTACT_TO_EMAIL=donghangsol@naver.com
EMAIL_INTAKE_ENABLED=false
# Configure only after retention and real-mail approval. Never expose the service key to the browser.
RESEND_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
EMAIL_INTAKE_ORGANIZATION_ID=
EMAIL_INTAKE_ALLOWED_SENDERS=
EMAIL_INTAKE_RECIPIENTS=
CONTACT_FROM_EMAIL="동행솔루션 <noreply@donghangsolution.co.kr>"

# Supabase Edge Function secret
# Comma-separated exact origins; do not use a wildcard.
# Example: https://app.donghangsolution.co.kr,https://preview.example.vercel.app
ALLOWED_ORIGINS=

# Naver IMAP: use a dedicated application password, entered only in Vercel server-side settings.
NAVER_IMAP_ENABLED=false
NAVER_IMAP_USER=donghangsol@naver.com
NAVER_IMAP_APP_PASSWORD=
CRON_SECRET=
